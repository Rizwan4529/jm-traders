# Apache / LiteSpeed config for the static Vite build (copied to dist/ on build).

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS (fixes the browser "Not secure" warning on http://).
  #    The X-Forwarded-Proto check avoids redirect loops behind a proxy/CDN.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Single-page-app fallback: serve index.html for client-side routes
  #    (/products, /about, ...) so direct links and refreshes don't 404.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Tell browsers to always use HTTPS for this site from now on.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>
